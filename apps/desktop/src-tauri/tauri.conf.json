{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watch Together",
  "version": "0.1.0",
  "identifier": "com.watchtogether.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "title": "Watch Together",
        "label": "main",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "center": true,
        "focus": true,
        "backgroundColor": "#00000000"
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "frameworks": []
    },
    "category": "Video",
    "shortDescription": "Synchronized collaborative video player",
    "longDescription": "Watch Together combines a local media player with direct peer-to-peer synchronized co-watching."
  }
}
